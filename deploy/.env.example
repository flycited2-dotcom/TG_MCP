# Values are paths and settings, never credentials or Telegram session strings.
TG_RUN_UID=10001
TG_RUN_GID=10001
TG_DATA_PATH=/opt/telegram-personal-mcp/data
TG_CREDENTIALS_PATH=/opt/telegram-personal-mcp/secrets/telegram.json
TG_PUBLIC_URL=https://telegram.example.com/telegram-personal-mcp
# Set true when the connected ChatGPT is allowed to send messages on your behalf.
TG_ALLOW_SEND=false
